---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<p class="givlocal-disclaimer">
	GivLocal is an independent product. It is not affiliated with, endorsed by, or supported by
	GivEnergy. GivEnergy is a trade mark of its owner and is used here only to describe hardware
	compatibility.
</p>

<style>
	@layer starlight.core {
		.givlocal-disclaimer {
			margin-top: 1.5rem;
			padding-top: 1.5rem;
			border-top: 1px solid var(--sl-color-gray-5);
			font-size: var(--sl-text-xs);
			color: var(--sl-color-gray-3);
		}
	}
</style>
